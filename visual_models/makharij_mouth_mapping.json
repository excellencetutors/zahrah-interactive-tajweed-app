<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zahrah Tajweed — Interactive Visual Mouth Model & Mapping Schema</title>
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts for Arabic and Modern UI -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            arabic: ['Amiri', 'serif'],
          },
          colors: {
            emerald: {
              850: '#064e3b',
              900: '#022c22',
            },
            gold: {
              400: '#fbbf24',
              500: '#f59e0b',
              600: '#d97706',
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Smooth transitions for SVG mouth components */
    .mouth-path {
      transition: d 0.4s cubic-bezier(0.4, 0, 0.2, 1), fill 0.3s ease, stroke 0.3s ease;
    }
    .air-flow {
      stroke-dasharray: 8;
      animation: flow 1.2s linear infinite;
    }
    @keyframes flow {
      from { stroke-dashoffset: 32; }
      to { stroke-dashoffset: 0; }
    }
    @keyframes pulse-makhraj {
      0%, 100% { transform: scale(1); opacity: 0.8; }
      50% { transform: scale(1.4); opacity: 1; }
    }
    .makhraj-glow {
      animation: pulse-makhraj 1.5s ease-in-out infinite;
      transform-origin: center;
    }
    /* Custom Scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col antialiased selection:bg-emerald-500 selection:text-white">

  <!-- Header -->
  <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-slate-950 font-bold text-xl shadow-lg shadow-emerald-900/40 font-arabic">
          ز
        </div>
        <div>
          <h1 class="font-bold text-lg text-slate-100 leading-tight">Zahrah Tajweed</h1>
          <p class="text-xs text-emerald-400 font-medium">Visual Mouth Model & Makharij Engine</p>
        </div>
      </div>
      
      <div class="flex items-center space-x-2 sm:space-x-4">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-950/80 text-emerald-400 border border-emerald-800">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-1.5"></span>
          Interactive Engine Ready
        </span>
        <button id="toggle-labels-btn" class="text-xs px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 transition font-medium border border-slate-700">
          Toggle Labels
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- Left Panel: Makhraj Zones & Letter Selector (3 cols) -->
    <section class="lg:col-span-3 flex flex-col space-y-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 flex items-center justify-between">
          <span>Select Letter / Makhraj</span>
          <span id="letter-count" class="text-emerald-400 text-[10px] bg-slate-800 px-2 py-0.5 rounded-full">10 Presets</span>
        </h2>
        
        <!-- Filter Pills for Zones -->
        <div class="flex flex-wrap gap-1 mb-4 pb-2 border-b border-slate-800" id="zone-filter-container">
          <button data-zone="ALL" class="zone-pill text-xs px-2.5 py-1 rounded-md bg-emerald-600 text-white font-medium transition">All</button>
          <button data-zone="Halq" class="zone-pill text-xs px-2.5 py-1 rounded-md bg-slate-800 text-slate-400 hover:bg-slate-700 transition">Halq</button>
          <button data-zone="Lisan" class="zone-pill text-xs px-2.5 py-1 rounded-md bg-slate-800 text-slate-400 hover:bg-slate-700 transition">Lisan</button>
          <button data-zone="Shafat" class="zone-pill text-xs px-2.5 py-1 rounded-md bg-slate-800 text-slate-400 hover:bg-slate-700 transition">Shafat</button>
          <button data-zone="Jawf" class="zone-pill text-xs px-2.5 py-1 rounded-md bg-slate-800 text-slate-400 hover:bg-slate-700 transition">Jawf</button>
        </div>

        <!-- Letter Grid -->
        <div class="grid grid-cols-3 gap-2 overflow-y-auto max-h-[460px] pr-1" id="letter-grid">
          <!-- Letter cards inserted via JS -->
        </div>
      </div>

      <!-- Quick Makhraj Info Card -->
      <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 flex-1 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-semibold text-gold-500 uppercase tracking-wider">Active Zone Specification</span>
          <h3 id="info-zone-name" class="font-bold text-slate-100 text-base mt-0.5">Al-Lisan (Tongue Root)</h3>
          <p id="info-zone-desc" class="text-xs text-slate-400 mt-1 leading-relaxed">
            The root of the tongue elevates towards the soft palate (Velum) to block and release air cleanly.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-xs">
          <span class="text-slate-500">Makhraj ID:</span>
          <span id="info-makhraj-id" class="font-mono text-emerald-400 font-semibold">lisan_root_qaf</span>
        </div>
      </div>
    </section>

    <!-- Center Panel: 2D Sagittal Mouth Model SVG & Animation Controls (5 cols) -->
    <section class="lg:col-span-5 flex flex-col space-y-4">
      <!-- SVG Canvas Box -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl flex flex-col items-center justify-center relative overflow-hidden min-h-[440px]">
        
        <!-- Top Status Overlay -->
        <div class="absolute top-3 left-4 right-4 flex items-center justify-between z-10">
          <div class="flex items-center space-x-2 bg-slate-950/80 backdrop-blur px-3 py-1.5 rounded-xl border border-slate-800">
            <span id="active-arabic-display" class="font-arabic text-2xl text-gold-400 font-bold leading-none">ق</span>
            <div class="border-l border-slate-800 pl-2">
              <span id="active-translit-display" class="text-xs font-semibold text-slate-200 block">Qaaf (ق)</span>
              <span id="active-sifat-tag" class="text-[10px] text-emerald-400 block">Isti'la + Qalqalah</span>
            </div>
          </div>
          
          <div class="bg-slate-950/80 backdrop-blur px-3 py-1.5 rounded-xl border border-slate-800 text-right">
            <span id="phase-badge" class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider block">CONTACT PHASE</span>
            <span id="nasal-status-badge" class="text-[10px] text-slate-400 block">Velum: Closed</span>
          </div>
        </div>

        <!-- 2D Sagittal SVG Mouth Model -->
        <svg id="mouth-svg" viewBox="0 0 500 450" class="w-full h-auto max-w-[440px] drop-shadow-2xl">
          <defs>
            <!-- Airflow Gradient -->
            <linearGradient id="airGradient" x1="0%" y1="100%" x2="0%" y2="0%">
              <stop offset="0%" stop-color="#34d399" stop-opacity="0.8"/>
              <stop offset="100%" stop-color="#fbbf24" stop-opacity="0.9"/>
            </linearGradient>
            <!-- Makhraj Highlight Radial -->
            <radialGradient id="glowRad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#fbbf24" stop-opacity="1"/>
              <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
            </radialGradient>
          </defs>

          <!-- 1. Background Cavity/Pharynx Base -->
          <path d="M 100 420 L 100 240 Q 100 120 220 100 Q 320 80 440 100" fill="none" stroke="#1e293b" stroke-width="24" stroke-linecap="round"/>
          
          <!-- 2. Nasal Cavity (Khayshum) -->
          <path id="nasal-cavity-path" d="M 220 100 Q 300 40 400 90 L 400 130" fill="none" stroke="#334155" stroke-width="12" stroke-linecap="round" opacity="0.6"/>
          <text x="310" y="70" class="text-[10px] fill-slate-500 font-sans anatomical-label">Nasal Cavity (Khayshum)</text>

          <!-- 3. Air Flow Stream (Dynamic Path) -->
          <path id="air-flow-path" d="M 120 400 Q 120 240 220 180 Q 320 170 420 210" fill="none" stroke="url(#airGradient)" stroke-width="8" class="air-flow" stroke-linecap="round"/>

          <!-- 4. Hard Palate & Upper Jaw -->
          <path d="M 230 140 Q 310 135 380 180" fill="none" stroke="#64748b" stroke-width="14" stroke-linecap="round"/>
          <text x="280" y="125" class="text-[10px] fill-slate-400 font-sans anatomical-label">Hard Palate</text>

          <!-- 5. Soft Palate / Velum (Dynamic Morph) -->
          <path id="velum-path" class="mouth-path" d="M 180 160 Q 210 160 230 140" fill="none" stroke="#fbbf24" stroke-width="10" stroke-linecap="round"/>
          <text x="160" y="145" class="text-[10px] fill-amber-400 font-sans anatomical-label">Velum</text>

          <!-- 6. Teeth -->
          <!-- Upper Front Incisors -->
          <path d="M 382 176 L 388 200 L 396 198 L 390 174 Z" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1"/>
          <!-- Lower Front Incisors -->
          <path id="lower-teeth" class="mouth-path" d="M 382 260 L 388 236 L 396 238 L 390 262 Z" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1"/>

          <!-- 7. Dynamic Tongue (Root, Body, Tip) -->
          <!-- Base tongue shape dynamically updated via d attribute -->
          <path id="tongue-path" class="mouth-path" d="M 140 380 Q 150 290 220 270 Q 300 250 370 245 Q 330 350 200 390 Z" fill="#059669" fill-opacity="0.35" stroke="#10b981" stroke-width="6" stroke-linejoin="round"/>
          
          <!-- Tongue Region Labels -->
          <g id="tongue-labels" class="anatomical-label">
            <text x="170" y="340" class="text-[9px] fill-emerald-300 font-sans">Root</text>
            <text x="240" y="300" class="text-[9px] fill-emerald-300 font-sans">Body</text>
            <text x="330" y="270" class="text-[9px] fill-emerald-300 font-sans">Tip</text>
          </g>

          <!-- 8. Lips (Upper & Lower - Dynamic Morph) -->
          <!-- Upper Lip -->
          <path id="upper-lip-path" class="mouth-path" d="M 388 165 Q 410 170 420 185 Q 405 190 392 180 Z" fill="#f43f5e" fill-opacity="0.6" stroke="#e11d48" stroke-width="2"/>
          <!-- Lower Lip -->
          <path id="lower-lip-path" class="mouth-path" d="M 388 270 Q 415 265 422 245 Q 405 240 392 255 Z" fill="#f43f5e" fill-opacity="0.6" stroke="#e11d48" stroke-width="2"/>
          <text x="430" y="215" class="text-[10px] fill-rose-400 font-sans anatomical-label">Lips</text>

          <!-- 9. Makhraj Focus Contact Glow / Marker -->
          <g id="makhraj-marker-group" class="makhraj-glow">
            <circle id="makhraj-glow-circle" cx="220" cy="180" r="18" fill="url(#glowRad)"/>
            <circle id="makhraj-core-dot" cx="220" cy="180" r="5" fill="#ffffff" stroke="#d97706" stroke-width="2"/>
          </g>
        </svg>

        <!-- Bottom Controls Bar -->
        <div class="w-full bg-slate-950/90 backdrop-blur rounded-xl border border-slate-800 p-3 mt-2 flex flex-col space-y-3">
          
          <!-- Animation Step Progress -->
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-400 font-medium">Phase Breakdown:</span>
            <div class="flex items-center space-x-1" id="step-indicators">
              <span data-step="0" class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700">1. Rest</span>
              <span data-step="1" class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700">2. Prep</span>
              <span data-step="2" class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-600 text-white border border-emerald-500 shadow">3. Contact</span>
              <span data-step="3" class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700">4. Release</span>
            </div>
          </div>

          <!-- Main Control Buttons -->
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <button id="btn-play" class="w-9 h-9 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white flex items-center justify-center shadow transition">
                <svg id="play-icon" class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </button>
              <button id="btn-audio" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 text-gold-400 border border-slate-700 flex items-center justify-center transition">
                <svg class="w-5 h-5 stroke-current fill-none" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
              </button>
              <button id="btn-loop" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 border border-slate-700 font-medium transition flex items-center space-x-1">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>
                <span>Loop</span>
              </button>
            </div>

            <!-- Speed Selector -->
            <div class="flex items-center space-x-1 bg-slate-900 p-1 rounded-lg border border-slate-800 text-xs">
              <span class="text-[10px] text-slate-500 px-1">Speed:</span>
              <button data-speed="0.5" class="speed-btn px-1.5 py-0.5 rounded text-slate-400 hover:text-white">0.5x</button>
              <button data-speed="1.0" class="speed-btn px-1.5 py-0.5 rounded bg-emerald-600 text-white font-bold">1.0x</button>
              <button data-speed="1.5" class="speed-btn px-1.5 py-0.5 rounded text-slate-400 hover:text-white">1.5x</button>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Right Panel: Live JSON Schema Inspector (4 cols) -->
    <section class="lg:col-span-4 flex flex-col space-y-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl flex-1 flex flex-col">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400 fill-current" viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-200">visual_models/makharij_mouth_mapping.json</h2>
          </div>
          <button id="copy-json-btn" class="text-[10px] bg-slate-800 hover:bg-slate-700 text-emerald-400 px-2 py-1 rounded border border-slate-700 font-mono transition">
            Copy JSON
          </button>
        </div>

        <!-- JSON Code Viewer -->
        <div class="mt-3 flex-1 bg-slate-950 rounded-xl p-3 border border-slate-850 font-mono text-xs overflow-y-auto max-h-[480px]">
          <pre id="json-tree-display" class="text-emerald-300 leading-relaxed whitespace-pre-wrap"></pre>
        </div>

        <div class="mt-3 pt-2 border-t border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
          <span>Schema Validation: <strong class="text-emerald-400">PASSED (v2.1)</strong></span>
          <span class="text-slate-500 font-mono">100% SVG Parametric</span>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800 bg-slate-900/60 py-4 mt-auto">
    <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p>© 2026 Zahrah Tajweed Engine — Open EdTech Repository Standard</p>
      <p class="font-arabic text-slate-400">مَخَارِجُ الحُرُوفِ وَالصِّفَاتُ المصوَّرة</p>
    </div>
  </footer>

  <!-- App Script -->
