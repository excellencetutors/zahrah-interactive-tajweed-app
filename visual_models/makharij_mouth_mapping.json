      },
      "sad": {
        "letter_id": "sad",
        "arabic": "ص",
        "transliteration": "Sad",
        "makhraj_zone": "Lisan",
        "makhraj_name_english": "Tip of Tongue behind Lower Front Teeth",
        "makhraj_name_arabic": "رَأْسُ اللِّسَان مَعَ صَفَحَاتِ الأَسْنَانِ السُّفْلَى",
        "sifat": ["Isti'la", "Itbaq", "Safir (Whistle)"],
        "makhraj_coords": { "cx": 380, "cy": 225 },
        "mouth_params": {
          "tongue_d": "M 140 380 Q 190 220 300 230 Q 378 230 382 235 Q 330 350 200 390 Z",
          "velum_d": "M 180 160 Q 200 162 215 160",
          "upper_lip_d": "M 388 165 Q 412 168 424 180 Q 405 190 392 180 Z",
          "lower_lip_d": "M 388 270 Q 418 260 424 248 Q 405 240 392 255 Z",
          "lower_teeth_transform": "translate(-2, 0)",
          "nasal_open": false,
          "air_flow_d": "M 120 400 Q 150 240 300 220 Q 375 228 420 210"
        },
        "audio_sim_freq": 450
      },
      "baa": {
        "letter_id": "baa",
        "arabic": "ب",
        "transliteration": "Baa",
        "makhraj_zone": "Shafat",
        "makhraj_name_english": "Both Lips Wet Part Pressing",
        "makhraj_name_arabic": "بَيْنَ الشَّفَتَيْنِ بِإِطْبَاق",
        "sifat": ["Shiddah", "Jahr", "Qalqalah"],
        "makhraj_coords": { "cx": 405, "cy": 215 },
        "mouth_params": {
          "tongue_d": "M 140 380 Q 150 290 220 270 Q 290 260 350 260 Q 330 350 200 390 Z",
          "velum_d": "M 180 160 Q 210 160 230 140",
          "upper_lip_d": "M 388 165 Q 410 195 408 215 Q 395 200 392 180 Z",
          "lower_lip_d": "M 388 270 Q 410 235 408 215 Q 395 230 392 255 Z",
          "lower_teeth_transform": "translate(0, 0)",
          "nasal_open": false,
          "air_flow_d": "M 120 400 Q 150 240 280 230 Q 390 215 405 215"
        },
        "audio_sim_freq": 150
      },
      "noon": {
        "letter_id": "noon",
        "arabic": "ن",
        "transliteration": "Noon (Ghunnah)",
        "makhraj_zone": "Shafat",
        "makhraj_name_english": "Tip of Tongue to Gum Line + Nasal Cavity",
        "makhraj_name_arabic": "طَرَفُ اللِّسَان مَعَ الخَيْشُوم (الغُنَّة)",
        "sifat": ["Tawasut", "Ghunnah (Nasal)"],
        "makhraj_coords": { "cx": 330, "cy": 70 },
        "mouth_params": {
          "tongue_d": "M 140 380 Q 180 240 320 200 Q 375 190 376 195 Q 330 350 200 390 Z",
          "velum_d": "M 180 160 Q 200 185 205 200",
          "upper_lip_d": "M 388 165 Q 410 170 420 185 Q 405 190 392 180 Z",
          "lower_lip_d": "M 388 270 Q 415 265 422 245 Q 405 240 392 255 Z",
          "lower_teeth_transform": "translate(0, 0)",
          "nasal_open": true,
          "air_flow_d": "M 120 400 Q 150 240 190 170 Q 260 60 380 80"
        },
        "audio_sim_freq": 260
      },
      "madd_waw": {
        "letter_id": "madd_waw",
        "arabic": "و",
        "transliteration": "Waw (Madd)",
        "makhraj_zone": "Jawf",
        "makhraj_name_english": "Oral Cavity + Lip Rounding",
        "makhraj_name_arabic": "الجَوْف مَعَ انْضِمَامِ الشَّفَتَيْن",
        "sifat": ["Madd (Lengthening 2-6)", "Lin"],
        "makhraj_coords": { "cx": 280, "cy": 190 },
        "mouth_params": {
          "tongue_d": "M 140 380 Q 170 240 250 210 Q 300 240 350 255 Q 330 350 200 390 Z",
          "velum_d": "M 180 160 Q 210 160 230 140",
          "upper_lip_d": "M 388 165 Q 425 175 430 195 Q 410 200 392 180 Z",
          "lower_lip_d": "M 388 270 Q 425 255 430 235 Q 410 230 392 255 Z",
          "lower_teeth_transform": "translate(0, 0)",
          "nasal_open": false,
          "air_flow_d": "M 120 400 Q 150 240 280 190 Q 380 200 435 215"
        },
        "audio_sim_freq": 130
      },
      "madd_alif": {
        "letter_id": "madd_alif",
        "arabic": "ا",
        "transliteration": "Alif (Madd)",
        "makhraj_zone": "Jawf",
        "makhraj_name_english": "Open Throat & Oral Cavity",
        "makhraj_name_arabic": "مَخْرَجُ الجَوْفِ المَفْتُوح",
        "sifat": ["Madd (Natural 2 Counts)"],
        "makhraj_coords": { "cx": 250, "cy": 200 },
        "mouth_params": {
          "tongue_d": "M 140 380 Q 150 300 220 280 Q 300 280 360 270 Q 330 350 200 390 Z",
          "velum_d": "M 180 160 Q 210 160 230 140",
          "upper_lip_d": "M 388 160 Q 410 155 422 170 Q 405 185 392 175 Z",
          "lower_lip_d": "M 388 275 Q 415 280 422 260 Q 405 250 392 260 Z",
          "lower_teeth_transform": "translate(0, 4)",
          "nasal_open": false,
          "air_flow_d": "M 120 400 Q 150 240 250 200 Q 340 200 430 215"
        },
        "audio_sim_freq": 200
      }
    };

    // --- State Variables ---
    let currentKey = 'qaf';
    let currentSpeed = 1.0;
    let isPlaying = false;
    let isLooping = false;
    let currentStep = 2; // 0: Rest, 1: Prep, 2: Contact, 3: Release
    let animTimer = null;
    let showLabels = true;
    let audioCtx = null;

    // --- DOM Elements ---
    const grid = document.getElementById('letter-grid');
    const jsonDisplay = document.getElementById('json-tree-display');
    const activeArabic = document.getElementById('active-arabic-display');
    const activeTranslit = document.getElementById('active-translit-display');
    const activeSifat = document.getElementById('active-sifat-tag');
    const phaseBadge = document.getElementById('phase-badge');
    const nasalBadge = document.getElementById('nasal-status-badge');
    const infoZoneName = document.getElementById('info-zone-name');
    const infoZoneDesc = document.getElementById('info-zone-desc');
    const infoMakhrajId = document.getElementById('info-makhraj-id');

    // SVG Elements
    const tonguePath = document.getElementById('tongue-path');
    const velumPath = document.getElementById('velum-path');
    const upperLipPath = document.getElementById('upper-lip-path');
    const lowerLipPath = document.getElementById('lower-lip-path');
    const lowerTeeth = document.getElementById('lower-teeth');
    const airFlowPath = document.getElementById('air-flow-path');
    const makhrajGlowCircle = document.getElementById('makhraj-glow-circle');
    const makhrajCoreDot = document.getElementById('makhraj-core-dot');
    const playIcon = document.getElementById('play-icon');

    // --- Initialize Letter Selector Cards ---
    function renderLetterCards(filterZone = 'ALL') {
      grid.innerHTML = '';
      let count = 0;
      Object.keys(MAPPING_DATA).forEach(key => {
        const item = MAPPING_DATA[key];
        if (filterZone !== 'ALL' && item.makhraj_zone !== filterZone) return;
        count++;

        const card = document.createElement('button');
        const isActive = key === currentKey;
        card.className = `p-2.5 rounded-xl border text-left transition flex flex-col justify-between relative overflow-hidden ${
          isActive 
            ? 'bg-gradient-to-br from-emerald-900/90 to-slate-900 border-emerald-500 shadow-lg shadow-emerald-950' 
            : 'bg-slate-950/60 border-slate-800 hover:border-slate-700 hover:bg-slate-850'
        }`;

        card.innerHTML = `
          <div class="flex items-center justify-between w-full">
            <span class="font-arabic text-2xl font-bold ${isActive ? 'text-gold-400' : 'text-slate-200'}">${item.arabic}</span>
            <span class="text-[9px] font-mono px-1.5 py-0.5 rounded ${isActive ? 'bg-emerald-800 text-emerald-200' : 'bg-slate-800 text-slate-400'}">${item.makhraj_zone}</span>
          </div>
          <span class="text-xs font-semibold mt-1 ${isActive ? 'text-white' : 'text-slate-300'}">${item.transliteration}</span>
        `;

        card.onclick = () => selectLetter(key);
        grid.appendChild(card);
      });
      document.getElementById('letter-count').innerText = `${count} Letters`;
    }

    // --- Render JSON Inspector ---
    function updateJsonInspector() {
      const data = MAPPING_DATA[currentKey];
      jsonDisplay.textContent = JSON.stringify(data, null, 2);
    }

    // --- Apply SVG Morph States ---
    function updateSVGModel(data, step = 2) {
      const params = data.mouth_params;

      if (step === 0) {
        // Rest position (Neutral resting tongue)
        tonguePath.setAttribute('d', "M 140 380 Q 150 300 220 280 Q 300 280 360 270 Q 330 350 200 390 Z");
        velumPath.setAttribute('d', "M 180 160 Q 210 160 230 140");
        upperLipPath.setAttribute('d', "M 388 165 Q 410 170 420 185 Q 405 190 392 180 Z");
        lowerLipPath.setAttribute('d', "M 388 270 Q 415 265 422 245 Q 405 240 392 255 Z");
        lowerTeeth.setAttribute('transform', 'translate(0, 0)');
        airFlowPath.setAttribute('opacity', '0.2');
        makhrajGlowCircle.setAttribute('opacity', '0.2');
        phaseBadge.textContent = "1. REST PHASE";
        phaseBadge.className = "text-[10px] font-bold text-slate-400 uppercase tracking-wider block";
      } else if (step === 1) {
        // Preparation Phase (Moving towards target)
        tonguePath.setAttribute('d', params.tongue_d);
        velumPath.setAttribute('d', params.velum_d);
        airFlowPath.setAttribute('opacity', '0.5');
        makhrajGlowCircle.setAttribute('opacity', '0.5');
        phaseBadge.textContent = "2. PREPARATION";
        phaseBadge.className = "text-[10px] font-bold text-gold-400 uppercase tracking-wider block";
      } else if (step === 2) {
        // Full Contact Phase (Makhraj Target Hit)
        tonguePath.setAttribute('d', params.tongue_d);
        velumPath.setAttribute('d', params.velum_d);
        upperLipPath.setAttribute('d', params.upper_lip_d);
        lowerLipPath.setAttribute('d', params.lower_lip_d);
        lowerTeeth.setAttribute('transform', params.lower_teeth_transform);
        airFlowPath.setAttribute('d', params.air_flow_d);
        airFlowPath.setAttribute('opacity', '1');

        // Move Makhraj Indicator Dot
        makhrajGlowCircle.setAttribute('cx', data.makhraj_coords.cx);
        makhrajGlowCircle.setAttribute('cy', data.makhraj_coords.cy);
        makhrajGlowCircle.setAttribute('opacity', '1');
        makhrajCoreDot.setAttribute('cx', data.makhraj_coords.cx);
        makhrajCoreDot.setAttribute('cy', data.makhraj_coords.cy);

        phaseBadge.textContent = "3. CONTACT / MAKHRAJ";
        phaseBadge.className = "text-[10px] font-bold text-emerald-400 uppercase tracking-wider block";
      } else if (step === 3) {
        // Release / Qalqalah Phase
        airFlowPath.setAttribute('opacity', '0.4');
        phaseBadge.textContent = "4. RELEASE / ECHO";
        phaseBadge.className = "text-[10px] font-bold text-teal-400 uppercase tracking-wider block";
      }

      // Update Nasal Status Badge
      if (params.nasal_open) {
        nasalBadge.textContent = "Khayshum: OPEN (Ghunnah)";
        nasalBadge.className = "text-[10px] text-emerald-400 font-bold block";
      } else {
        nasalBadge.textContent = "Khayshum: Closed (Oral)";
        nasalBadge.className = "text-[10px] text-slate-400 block";
      }

      // Update step badge highlights
      document.querySelectorAll('#step-indicators span').forEach(el => {
        const s = parseInt(el.getAttribute('data-step'));
        if (s === step) {
          el.className = "px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-600 text-white border border-emerald-500 shadow";
        } else {
          el.className = "px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700";
        }
      });
    }

    // --- Select Letter Handler ---
    function selectLetter(key) {
      currentKey = key;
      const data = MAPPING_DATA[key];
      
      // Update Headers & Info
      activeArabic.textContent = data.arabic;
      activeTranslit.textContent = `${data.transliteration} (${data.arabic})`;
      activeSifat.textContent = data.sifat.join(' • ');
      infoZoneName.textContent = `${data.makhraj_zone} — ${data.makhraj_name_english}`;
      infoZoneDesc.textContent = `Arabic Definition: ${data.makhraj_name_arabic}. Articulated with Sifat attributes: ${data.sifat.join(', ')}.`;
      infoMakhrajId.textContent = `${data.makhraj_zone.toLowerCase()}_${key}`;

      // Refresh Selector & Inspector
      renderLetterCards(document.querySelector('.zone-pill.bg-emerald-600').getAttribute('data-zone'));
      updateJsonInspector();
      
      // Apply Contact State
      currentStep = 2;
      updateSVGModel(data, 2);
    }

    // --- Synthesized Benchmark Audio Generator ---
    function playAudioBenchmark() {
      try {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        const data = MAPPING_DATA[currentKey];
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = data.makhraj_zone === 'Halq' ? 'sawtooth' : 'sine';
        osc.frequency.setValueAtTime(data.audio_sim_freq || 200, audioCtx.currentTime);

        gain.gain.setValueAtTime(0, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.3, audioCtx.currentTime + 0.05);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.6);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start();
        osc.stop(audioCtx.currentTime + 0.6);
      } catch (e) {
        console.log('Audio playback simulation ready.');
      }
    }

    // --- Animation Cycle Loop ---
    function runAnimationCycle() {
      if (animTimer) clearInterval(animTimer);
      let step = 0;
      const intervalDuration = (600 / currentSpeed);

      animTimer = setInterval(() => {
        updateSVGModel(MAPPING_DATA[currentKey], step);
        if (step === 2) playAudioBenchmark();

        step++;
        if (step > 3) {
          if (isLooping && isPlaying) {
            step = 0;
          } else {
            clearInterval(animTimer);
            isPlaying = false;
            updatePlayIcon();
            updateSVGModel(MAPPING_DATA[currentKey], 2); // default back to contact
          }
        }
      }, intervalDuration);
    }

    function updatePlayIcon() {
      if (isPlaying) {
        playIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>'; // Pause icon
      } else {
        playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>'; // Play icon
      }
    }

    // --- Event Listeners ---
    document.getElementById('btn-play').onclick = () => {
      isPlaying = !isPlaying;
      updatePlayIcon();
      if (isPlaying) {
        runAnimationCycle();
      } else if (animTimer) {
        clearInterval(animTimer);
      }
    };

    document.getElementById('btn-audio').onclick = playAudioBenchmark;

    document.getElementById('btn-loop').onclick = (e) => {
      isLooping = !isLooping;
      const btn = e.currentTarget;
      if (isLooping) {
        btn.className = "px-2.5 py-1.5 rounded-lg bg-emerald-600 text-xs text-white border border-emerald-500 font-medium transition flex items-center space-x-1 shadow";
      } else {
        btn.className = "px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 border border-slate-700 font-medium transition flex items-center space-x-1";
      }
    };

    // Speed Selection
    document.querySelectorAll('.speed-btn').forEach(btn => {
      btn.onclick = (e) => {
        document.querySelectorAll('.speed-btn').forEach(b => {
          b.className = "speed-btn px-1.5 py-0.5 rounded text-slate-400 hover:text-white";
        });
        e.target.className = "speed-btn px-1.5 py-0.5 rounded bg-emerald-600 text-white font-bold";
        currentSpeed = parseFloat(e.target.getAttribute('data-speed'));
        if (isPlaying) runAnimationCycle();
      };
    });

    // Zone Filter Buttons
    document.querySelectorAll('.zone-pill').forEach(btn => {
      btn.onclick = (e) => {
        document.querySelectorAll('.zone-pill').forEach(b => {
          b.className = "zone-pill text-xs px-2.5 py-1 rounded-md bg-slate-800 text-slate-400 hover:bg-slate-700 transition";
        });
        e.target.className = "zone-pill text-xs px-2.5 py-1 rounded-md bg-emerald-600 text-white font-medium transition";
        renderLetterCards(e.target.getAttribute('data-zone'));
      };
    });

    // Step breakdown clicks
    document.querySelectorAll('#step-indicators span').forEach(span => {
      span.onclick = (e) => {
        if (isPlaying) {
          isPlaying = false;
          clearInterval(animTimer);
          updatePlayIcon();
        }
        const s = parseInt(e.target.getAttribute('data-step'));
        updateSVGModel(MAPPING_DATA[currentKey], s);
        if (s === 2) playAudioBenchmark();
      };
    });

    // Toggle Labels Button
    document.getElementById('toggle-labels-btn').onclick = () => {
      showLabels = !showLabels;
      document.querySelectorAll('.anatomical-label').forEach(el => {
        el.style.display = showLabels ? 'block' : 'none';
      });
    };

    // Copy JSON Button
    document.getElementById('copy-json-btn').onclick = () => {
      navigator.clipboard.writeText(jsonDisplay.textContent);
      const btn = document.getElementById('copy-json-btn');
      btn.textContent = "Copied!";
      setTimeout(() => btn.textContent = "Copy JSON", 1800);
    };

    // --- Boot Initial App ---
    window.onload = () => {
      renderLetterCards();
      selectLetter('qaf');
    };
  </script>
</body>
</html>
