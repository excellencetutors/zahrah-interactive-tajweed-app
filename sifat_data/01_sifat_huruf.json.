        },
        {
          "pair_name": "3. Isti'la' vs. Istifal",
          "isti'la": "Isti'la' (Elevation): Raising back of tongue toward roof of mouth (Heavy/Tafkheem). Letters (7): خُصَّ ضَغْطٍ قِظْ",
          "istifal": "Istifal (Lowering): Lowering tongue away from roof of mouth (Light/Tarqeeq). Letters (22): Remaining letters."
        },
        {
          "pair_name": "4. Itbaq vs. Infitah",
          "itbaq": "Itbaq (Closing/Embracing): Pressing a large portion of tongue against palate. Letters (4): ص، ض، ط، ظ",
          "infitah": "Infitah (Opening): Separation between tongue and palate. Letters (25): Remaining letters."
        },
        {
          "pair_name": "5. Idhlaq vs. Ismat",
          "idhlaq": "Idhlaq (Fluent): Articulation from tip/edge of tongue or lips. Letters (6): فِرَّ مَنْ لُبْ",
          "ismat": "Ismat (Restrained): Non-fluent letters requiring structural restraint. Letters (23): Remaining letters."
        }
      ]
